# Beyond the Rumour Mill — Module 1 (Experience Capture & Consensus) Environment Variables
# Use placeholders only. Never commit real credentials.

# Database
DATABASE_URL="postgresql://user:password@hostname:5432/database?sslmode=require"

# Better Auth Configuration
BETTER_AUTH_SECRET="your-32-char-random-secret-key-here"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# OAuth (Google)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Resend Email (Optional for testing)
RESEND_API_KEY="re_mock_key"
EMAIL_FROM="noreply@beyondtherumourmill.com"
